#!/usr/bin/env python3
"""hzploy — CLI for the devps control-plane agent.

Stdlib only (no pip install needed) so it runs the same from a VPS shell,
a Mac/Linux terminal, or Windows PowerShell (`python hzploy ...`).

Config: ~/.hzploy/config (written by `hzploy login`), or env vars
DEVPS_URL / DEVPS_TOKEN, which always take precedence.

Usage:
    hzploy login <url> <token>
    hzploy list
    hzploy up <name> <repo_url> [--ref main] [--domain d] \\
        --service name=port [--service name2=port2 ...] [--primary name]
    hzploy adopt <name> <container_name> [--domain d]
    hzploy logs <name> [--tail 200]
    hzploy restart <name>
    hzploy rm <name>
"""

import argparse
import json
import sys
import urllib.error
import urllib.request
from pathlib import Path

CONFIG_PATH = Path.home() / ".hzploy" / "config"


def load_config() -> dict:
    if CONFIG_PATH.exists():
        return json.loads(CONFIG_PATH.read_text())
    return {}


def save_config(cfg: dict) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(cfg))
    CONFIG_PATH.chmod(0o600)


def get_creds() -> tuple[str, str]:
    import os

    cfg = load_config()
    url = os.environ.get("DEVPS_URL", cfg.get("url"))
    token = os.environ.get("DEVPS_TOKEN", cfg.get("token"))
    if not url or not token:
        sys.exit(
            "not logged in — run `hzploy login <url> <token>` first, "
            "or set DEVPS_URL/DEVPS_TOKEN"
        )
    return url.rstrip("/"), token


def call(method: str, path: str, body: dict | None = None) -> object:
    url, token = get_creds()
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        f"{url}{path}",
        data=data,
        method=method,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:  # noqa: S310 — internal tool, fixed scheme
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        sys.exit(f"HTTP {e.code}: {e.read().decode()}")


def cmd_login(args: argparse.Namespace) -> None:
    save_config({"url": args.url, "token": args.token})
    print(f"saved config to {CONFIG_PATH}")


def cmd_list(_args: argparse.Namespace) -> None:
    projects = call("GET", "/projects")
    if not projects:
        print("no projects registered yet")
        return
    for p in projects:
        port_str = ", ".join(f"{pt['service']}:{pt['host_port']}" for pt in p["ports"])
        domain = p.get("domain") or "-"
        print(f"{p['name']:<20} {p['managed_by']:<8} {p['status']:<12} {domain:<30} {port_str}")


def cmd_up(args: argparse.Namespace) -> None:
    services = dict(item.split("=", 1) for item in (args.service or []))
    services = {k: int(v) for k, v in services.items()}
    body = {
        "repo_url": args.repo,
        "git_ref": args.ref,
        "domain": args.domain,
        "services": services,
        "primary_service": args.primary,
    }
    print(json.dumps(call("POST", f"/projects/{args.name}/deploy", body), indent=2))


def cmd_adopt(args: argparse.Namespace) -> None:
    body = {"container_name": args.container, "domain": args.domain}
    print(json.dumps(call("POST", f"/projects/{args.name}/adopt", body), indent=2))


def cmd_logs(args: argparse.Namespace) -> None:
    result = call("GET", f"/projects/{args.name}/logs?tail={args.tail}")
    print(result["logs"])


def cmd_restart(args: argparse.Namespace) -> None:
    print(call("POST", f"/projects/{args.name}/restart"))


def cmd_rm(args: argparse.Namespace) -> None:
    print(call("DELETE", f"/projects/{args.name}"))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="hzploy")
    sub = parser.add_subparsers(required=True)

    p = sub.add_parser("login", help="save the agent URL + token locally")
    p.add_argument("url")
    p.add_argument("token")
    p.set_defaults(func=cmd_login)

    p = sub.add_parser("list", help="list every registered project")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("up", help="deploy a project from git")
    p.add_argument("name")
    p.add_argument("repo")
    p.add_argument("--ref", default="main")
    p.add_argument("--domain")
    p.add_argument(
        "--service", action="append", metavar="name=port", help="repeatable, e.g. --service web=3000"
    )
    p.add_argument("--primary", help="which --service is public; required with --domain")
    p.set_defaults(func=cmd_up)

    p = sub.add_parser("adopt", help="register an already-running container")
    p.add_argument("name")
    p.add_argument("container")
    p.add_argument("--domain")
    p.set_defaults(func=cmd_adopt)

    p = sub.add_parser("logs")
    p.add_argument("name")
    p.add_argument("--tail", type=int, default=200)
    p.set_defaults(func=cmd_logs)

    p = sub.add_parser("restart")
    p.add_argument("name")
    p.set_defaults(func=cmd_restart)

    p = sub.add_parser("rm", help="deregister (does not stop containers)")
    p.add_argument("name")
    p.set_defaults(func=cmd_rm)

    return parser


def main() -> None:
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
